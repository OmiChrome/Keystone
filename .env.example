# Any OpenAI-compatible endpoint works (AMD TokenLab, vLLM, Ollama, LM Studio...)
KEYSTONE_LLM_BASE_URL=https://api.tokenlab.amd.com/v1
KEYSTONE_LLM_API_KEY=replace-me
KEYSTONE_MODEL=DeepSeek-V4.1-Flash
# Second, different model family used as an independent verifier on disputed findings
KEYSTONE_VERIFIER_MODEL=Gemma-4-31B-IT
# Tried in order when a model is overloaded / unavailable
KEYSTONE_FALLBACK_MODELS=Gemma-4-31B-IT,Qwen3.8-27B,DeepSeek-V4-Flash,MiniCPM-V-4.7-35B-A3B
# Requests per minute allowed by your provider
KEYSTONE_RPM=18
# 1 = cache LLM responses on disk (reproducible demos, zero cost on re-run)
KEYSTONE_CACHE=1
